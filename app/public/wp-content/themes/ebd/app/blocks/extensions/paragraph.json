{
  "$schema": "https://blockstudio.dev/schema/extend",
  "name": "core/paragraph",
  "blockstudio": {
    "extend": true,
    "attributes": [
      {
        "type": "custom/typography"
      },
      {
        "id": "limit_width",
        "type": "toggle",
        "label": "Limit Width?",
        "help": "Caps the paragraph at 1000px wide.",
        "default": false,
        "set": [
          {
            "attribute": "class",
            "value": "mw-1000"
          }
        ]
      },
      {
        "id": "use_heading_font",
        "type": "toggle",
        "label": "Use Heading Font?",
        "help": "Applies the heading font family (Poppins) to this paragraph.",
        "default": false,
        "set": [
          {
            "attribute": "class",
            "value": "font-heading"
          }
        ]
      },
      {
        "id": "margin_bottom",
        "type": "select",
        "label": "Margin Bottom",
        "default": "",
        "options": [
          { "value": "", "label": "Default" },
          { "value": "mb-0", "label": "None" },
          { "value": "mb-small", "label": "Small" }
        ],
        "set": [
          {
            "attribute": "class",
            "value": "{attributes.margin_bottom}"
          }
        ]
      }
    ]
  }
}
